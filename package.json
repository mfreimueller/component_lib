{
  "name": "component_lib",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Reusable components for agents to copy into projects, with a human showcase site.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build:embed": "vite build --config components/parsons/embed/vite.config.ts",
    "catalog": "node scripts/build-catalog.ts",
    "catalog:check": "node scripts/build-catalog.ts --check",
    "build:skill": "vite build --config components/parsons/skills/vite.config.ts --logLevel warn",
    "dev": "npm run dev -w site",
    "build": "npm run build:embed && npm run build -w site",
    "check:site": "npm run check -w site",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "jsdom": "^31.0.0",
    "reveal.js": "^6.0.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-dnd-action": "^0.9.80",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "site"
  ]
}
