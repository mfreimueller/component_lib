{
  "function": "templatePercent",
  "description": "Template puzzles. placed[g] = piece texts in gap g (missing entries = empty). flags[g] = correctFlags(gaps[g], placed[g]).",
  "cases": [
    {
      "name": "solution with a decoy gap left empty",
      "input": {
        "gaps": [
          {
            "expected": [
              "a",
              "b"
            ],
            "anyOrder": false
          },
          {
            "expected": [],
            "anyOrder": false
          }
        ],
        "placed": [
          [
            "a",
            "b"
          ],
          []
        ]
      },
      "expected": {
        "flags": [
          [
            true,
            true
          ],
          []
        ],
        "percentRounded": 100
      }
    },
    {
      "name": "missing piece counts against expected length",
      "input": {
        "gaps": [
          {
            "expected": [
              "a",
              "b"
            ],
            "anyOrder": false
          }
        ],
        "placed": [
          [
            "a"
          ]
        ]
      },
      "expected": {
        "flags": [
          [
            true
          ]
        ],
        "percentRounded": 50
      }
    },
    {
      "name": "extra piece counts against placed length",
      "input": {
        "gaps": [
          {
            "expected": [
              "a"
            ],
            "anyOrder": false
          }
        ],
        "placed": [
          [
            "a",
            "x"
          ]
        ]
      },
      "expected": {
        "flags": [
          [
            true,
            false
          ]
        ],
        "percentRounded": 50
      }
    },
    {
      "name": "red herring only",
      "input": {
        "gaps": [
          {
            "expected": [
              "a"
            ],
            "anyOrder": false
          }
        ],
        "placed": [
          [
            "herring"
          ]
        ]
      },
      "expected": {
        "flags": [
          [
            false
          ]
        ],
        "percentRounded": 0
      }
    },
    {
      "name": "anything in an empty gap is penalised",
      "input": {
        "gaps": [
          {
            "expected": [
              "a"
            ],
            "anyOrder": false
          },
          {
            "expected": [],
            "anyOrder": false
